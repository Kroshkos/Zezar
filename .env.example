# ================= Ядро =================
APP_NAME=Цезарь — УСИП
SECRET_KEY=change-me
DATABASE_PATH=/data/caesar.db          # SQLite-файл строго в /data (монтируется volume'ом)
DATA_DIR=/data

# ================= Администратор (вход по логину и паролю) =================
# Авторизация через Яндекс ID удалена — единственный контур входа: логин + пароль.
# При старте сервиса сид создаёт/синхронизирует учётную запись администратора.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-strong-password
# Несколько админов через запятую (необязательно): user1:pass1,user2:pass2
ADMIN_LOGINS=

# ================= Telegram =================
TELEGRAM_BOT_TOKEN=
TELEGRAM_NOTIFY_ENABLED=true

# ================= Яндекс.Календарь (DAV) =================
YANDEX_CAL_ENABLED=true
YANDEX_CAL_BASE=https://webdav.yandex.ru
YANDEX_CAL_DEFAULT_CALENDAR=default

# ================= Фоновые задачи =================
SYNC_INTERVAL_SECONDS=300              # периодическая синхронизация календаря
CAL_CRON=*/5 * * * *                   # cron для планировщика (ARQ/worker)

# ================= Продакшен =================
# ENVIRONMENT=production включает fail-fast: приложение НЕ стартует, если
# SECRET_KEY=change-me / короче 32 символов, включён DEV_LOGIN или SEED_DEMO_DATA,
# не заданы ADMIN_USERNAME/ADMIN_PASSWORD или SECRET_KEY слабый. Сгенерируйте секрет: python -c "import secrets;print(secrets.token_hex(32))"
ENVIRONMENT=development
# Secure-флаг session-cookie: не задано => Secure только в production (за HTTPS за трафик-прокси)
# COOKIE_SECURE=true
# Демо-сид прототипа (только development!)
SEED_DEMO_DATA=false

# ================= Хостинг с TLS-терминированием на балансировщике (Amvera и т.п.) =================
# PORT — порт, который слушает uvicorn (Dockerfile подхватывает его из окружения).
# На Amvera задаётся через amvera.yaml (containerPort: 8000), менять не требуется.
PORT=8000
# Доверять X-Forwarded-* от reverse-proxy хостинга:
TRUST_PROXY_HEADERS=true
# Если браузер видит только HTTPS снаружи, но cookie со Secure-флагом не принимаются —
# временно поставьте COOKIE_SECURE=false (безопасно только за TLS-терминатором провайдера).
# COOKIE_SECURE=false
# IP трафик-прокси для uvicorn --forwarded-allow-ips (по умолчанию *; для VPS сузьте до 127.0.0.1)
# FORWARDED_ALLOW_IPS=*
