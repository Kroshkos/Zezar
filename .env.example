# ================= Ядро =================
APP_NAME=Цезарь — УСИП
SECRET_KEY=change-me
DATABASE_PATH=/data/caesar.db          # SQLite-файл строго в /data (монтируется volume'ом)
DATA_DIR=/data

# ================= OAuth 2.0 — Яндекс ID =================
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost:8000/auth/callback
# Список Yandex ID (sub), которым разрешено входить при пустой БД (первый админ)
BOOTSTRAP_ADMIN_YA_IDS=

# ================= Telegram =================
TELEGRAM_BOT_TOKEN=
TELEGRAM_NOTIFY_ENABLED=true

# ================= Яндекс.Календарь (DAV) =================
YANDEX_CAL_ENABLED=true
YANDEX_CAL_BASE=https://webdav.yandex.ru
YANDEX_CAL_DEFAULT_CALENDAR=default

# ================= Фоновые задачи =================
SYNC_INTERVAL_SECONDS=300              # периодическая синхронизация календаря
CAL_CRON=*/5 * * * *                   # cron для планировщика (ARQ/worker)

# ================= Продакшен =================
# ENVIRONMENT=production включает fail-fast: приложение НЕ стартует, если
# SECRET_KEY=change-me / короче 32 символов, включён DEV_LOGIN или SEED_DEMO_DATA,
# не заданы YANDEX_CLIENT_ID/SECRET. Сгенерируйте секрет: python -c "import secrets;print(secrets.token_hex(32))"
ENVIRONMENT=development
# Secure-флаг session-cookie: не задано => Secure только в production (за HTTPS за трафик-прокси)
# COOKIE_SECURE=true
# Демо-сид прототипа (только development!)
SEED_DEMO_DATA=false
